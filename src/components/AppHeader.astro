---
import Container from './Container.astro'

const links = [
  {
    to: '/#servicios',
    label: 'Servicios',
  },
  {
    to: '/#galeria',
    label: 'Galería',
  },
]
---

<script>
  let isToggled = false
  const navlinks = document.querySelector('#navlinks')
  const hamburger = document.querySelector('#hamburger')
  const layer = document.querySelector('#navLayer')
  const links = [...navlinks.querySelector('ul').children]

  function toggleNavlinks() {
    if (isToggled) {
      navlinks.classList.add(
        'visible!',
        'scale-100!',
        'opacity-100!',
        'lg:translate-y-0!'
      )
      hamburger.classList.add('toggled')
      layer.classList.add('origin-top', 'scale-y-100')
    } else {
      navlinks.classList.remove(
        'visible!',
        'scale-100!',
        'opacity-100!',
        'lg:translate-y-0!'
      )
      hamburger.classList.remove('toggled')
      layer.classList.remove('origin-top', 'scale-y-100')
    }
  }

  hamburger.addEventListener('click', () => {
    isToggled = !isToggled
    toggleNavlinks()
  })

  links.forEach((link) => {
    link.addEventListener('click', () => {
      isToggled = false
      toggleNavlinks()
    })
  })
</script>

<header class='relative z-20 border-b border-line'>
  <nav class='relative'>
    <Container>
      <div class='relative flex items-center justify-between gap-6 py-4 lg:py-5'>
        <div class='relative z-20 flex w-full items-center justify-between lg:w-max'>
          <a href='/#home' aria-label='AsoAfro' class='flex items-baseline gap-2.5'>
            <span
              class='font-display text-2xl tracking-tight text-ink-bright transition hover:scale-105 active:scale-95'
              >AsoAfro</span
            >
            <span class='size-[7px] rounded-full bg-primary-400'></span>
          </a>

          <div class='relative flex max-h-10 items-center lg:hidden'>
            <button aria-label='Menú' id='hamburger' class='relative -mr-6 p-6'>
              <div
                aria-hidden='true'
                id='line'
                class='m-auto h-0.5 w-7 rounded-sm bg-ink transition duration-300'
              >
              </div>
              <div
                aria-hidden='true'
                id='line2'
                class='m-auto mt-2 h-0.5 w-7 rounded-sm bg-ink transition duration-300'
              >
              </div>
            </button>
          </div>
        </div>

        <div
          id='navLayer'
          aria-hidden='true'
          class='fixed inset-0 z-10 h-screen w-screen origin-bottom scale-y-0 bg-canvas/90 backdrop-blur-xl transition duration-500 lg:hidden'
        >
        </div>

        <div
          id='navlinks'
          class='invisible absolute top-full left-0 z-20 w-full origin-top-right translate-y-1 scale-90 flex-col justify-end gap-6 rounded-3xl border border-line bg-surface p-8 opacity-0 transition-all duration-300 lg:visible lg:relative lg:flex lg:w-max lg:translate-y-0 lg:scale-100 lg:flex-row lg:items-center lg:gap-0 lg:border-none lg:bg-transparent lg:p-0 lg:opacity-100'
        >
          <ul
            class='flex flex-col items-center justify-center gap-6 lg:flex-row lg:items-center lg:gap-9'
          >
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.to}
                    class='block text-lg text-ink-muted transition duration-150 hover:text-primary-400 lg:text-[15px]'
                  >
                    <span>{link.label}</span>
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href='/#formulario'
                class='flex items-center gap-2.5 rounded-full bg-primary-400 px-6 py-3 text-lg font-bold text-on-accent transition duration-150 hover:bg-primary-300 lg:px-5 lg:py-2.5 lg:text-[15px]'
              >
                Contáctanos
                <svg
                  class='size-4 shrink-0'
                  xmlns='http://www.w3.org/2000/svg'
                  viewBox='0 0 24 24'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='2.4'
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  aria-hidden='true'
                >
                  <path d='M5 12h14'></path>
                  <path d='m12 5 7 7-7 7'></path>
                </svg>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </Container>
  </nav>
</header>

<style>
  @reference '../styles/global.css';

  .toggled div:first-child {
    @apply translate-y-[5px] rotate-45;
  }

  .toggled div:last-child {
    @apply -translate-y-[5px] -rotate-45;
  }
</style>
