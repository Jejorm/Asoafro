---
import Container from './Container.astro'
import Eyebrow from './Eyebrow.astro'
import FirstImage from './images/FirstImage.astro'
import SecondImage from './images/SecondImage.astro'
import ThirdImage from './images/ThirdImage.astro'
import ForthImage from './images/FourthImage.astro'
import FifthImage from './images/FifthImage.astro'
import SixthImage from './images/SixthImage.astro'
import EleventhImage from './images/EleventhImage.astro'
import TwelfthImage from './images/TwelfthImage.astro'
import ThirteenthImage from './images/ThirteenthImage.astro'
import FourteenthImage from './images/FourteenthImage.astro'

const slides = [
  FirstImage,
  SecondImage,
  ThirdImage,
  ForthImage,
  FifthImage,
  SixthImage,
  EleventhImage,
  TwelfthImage,
  ThirteenthImage,
  FourteenthImage,
]
---

<section id='galeria'>
  <Container>
    <div class='embla'>
      <div
        class='mb-8 flex flex-col gap-6 sm:mb-10 sm:flex-row sm:items-end sm:justify-between'
      >
        <div class='flex flex-col gap-5'>
          <Eyebrow text='Galería' />
          <h2 class='text-4xl leading-none text-ink-bright sm:text-5xl xl:text-[54px]'>
            Nuestra Galería
          </h2>
          <p class='max-w-md text-base leading-relaxed text-ink-muted sm:text-lg'>
            Trabajos reales de limpieza y jardinería en casas, oficinas y áreas
            verdes de todo el Azuay.
          </p>
        </div>

        <div class='flex items-center gap-3 self-end'>
          <button
            type='button'
            aria-label='Imagen anterior'
            class='embla__button embla__button--prev flex size-12 cursor-pointer items-center justify-center rounded-full border border-line-strong text-ink transition duration-150 hover:border-primary-400 hover:text-primary-400 active:scale-95 sm:size-14'
          >
            <svg
              class='size-4.5'
              xmlns='http://www.w3.org/2000/svg'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <path d='m15 18-6-6 6-6'></path>
            </svg>
          </button>
          <button
            type='button'
            aria-label='Imagen siguiente'
            class='embla__button embla__button--next flex size-12 cursor-pointer items-center justify-center rounded-full bg-primary-400 text-on-accent transition duration-150 hover:bg-primary-300 active:scale-95 sm:size-14'
          >
            <svg
              class='size-4.5'
              xmlns='http://www.w3.org/2000/svg'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <path d='m9 18 6-6-6-6'></path>
            </svg>
          </button>
        </div>
      </div>

      <div
        class='embla__viewport reveal h-[240px] overflow-hidden rounded-card border border-line sm:h-[360px] lg:h-[520px] xl:h-[560px]'
      >
        <div class='embla__container flex h-full touch-pan-y'>
          {
            slides.map((Slide) => (
              <div class='embla__slide h-full min-w-0 shrink-0 grow-0 basis-full'>
                <Slide />
              </div>
            ))
          }
        </div>
      </div>

      <!-- Ten dots do not fit on a phone without wrapping into a second row,
           so below `sm` the counter carries the position and swiping does the
           navigating. -->
      <div class='mt-6 flex items-center justify-between gap-6'>
        <div class='embla__dots hidden items-center gap-2.5 sm:flex'></div>
        <span
          class='embla__selected-snap-display font-display w-full shrink-0 text-center text-sm tracking-wide text-ink-faint sm:w-auto sm:text-right'
          >—</span
        >
      </div>
    </div>
  </Container>
</section>

<style>
  /* The ordinal image wrappers render their own <Image>, so the fill rule has
     to reach past the scope boundary. */
  .embla__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .embla__container {
    backface-visibility: hidden;
  }

  /* Built by carousel.js, so these stay plain CSS rather than utilities the
     scanner would never see — and `:global`, because runtime-inserted nodes
     never carry Astro's scope attribute. */
  .embla__dots :global(.embla__dot) {
    width: 28px;
    height: 4px;
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background: var(--color-line-strong);
    cursor: pointer;
    transition: background 150ms ease;
  }

  @media (min-width: 640px) {
    .embla__dots :global(.embla__dot) {
      width: 40px;
    }
  }

  .embla__dots :global(.embla__dot:hover) {
    background: var(--color-primary-700);
  }

  .embla__dots :global(.embla__dot--selected),
  .embla__dots :global(.embla__dot--selected:hover) {
    background: var(--color-primary-400);
  }
</style>

<script src='../carousel.js'></script>
