---
// The section kicker: a short accent rule followed by an uppercase label.
// Used above every section heading so the page opens each block the same way.
interface Props {
  text: string
  class?: string
}

const { text, class: className } = Astro.props
---

<div class:list={['flex items-center gap-4', className]}>
  <span
    aria-hidden='true'
    class='block h-0.5 w-8 shrink-0 bg-primary-400 sm:w-12'></span>
  <span
    class='text-xs font-bold tracking-[0.2em] text-primary-400 uppercase sm:tracking-[0.24em]'
    >{text}</span
  >
</div>
