---
import Container from './Container.astro'
import Eyebrow from './Eyebrow.astro'

// `tone` picks the accent a card is drawn with: teal for the cleaning
// services, warm tan for gardening. The closing bullet of every card is the
// promise rather than the task, so it always gets the warm accent.
const services = [
  {
    title: 'Casas y Hogares',
    tone: 'teal',
    icon: `<path d='M3 10.5 12 3l9 7.5'></path><path d='M5 9.5V21h14V9.5'></path><path d='M10 21v-6h4v6'></path>`,
    items: [
      'Desinfección de Superficies.',
      'Aspirado y Trapeado de Suelos.',
      'Limpieza de Ventanas.',
      'Productos Seguros y Eficaces.',
    ],
  },
  {
    title: 'Oficinas e Instituciones',
    tone: 'teal',
    icon: `<rect x='4' y='3' width='16' height='18' rx='1.5'></rect><path d='M9 7.5h2M13 7.5h2M9 12h2M13 12h2'></path><path d='M10 21v-4h4v4'></path>`,
    items: [
      'Desinfección de Áreas Comunes.',
      'Limpieza de Superficies de Alto Contacto.',
      'Mantenimiento de Baños y Cocinas.',
      'Adaptación a sus Horarios y Necesidades.',
    ],
  },
  {
    title: 'Colchones y Muebles',
    tone: 'teal',
    icon: `<path d='M4 11V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3'></path><path d='M2 14a2 2 0 0 1 4 0v3h12v-3a2 2 0 0 1 4 0v5H2z'></path>`,
    items: [
      'Eliminación de Ácaros y Alérgenos.',
      'Técnicas Avanzadas de Inyección - Extracción.',
      'Remoción de Manchas, Olores y Suciedad.',
      'Resultado Impecable con Confort Renovado.',
    ],
  },
  {
    title: 'Jardinería y Áreas Verdes',
    tone: 'warm',
    icon: `<path d='M20 4c0 8.5-5.4 13-13 13H4C4 8.5 9.4 4 17 4z'></path><path d='M4 20c2.4-6.2 6.4-9.4 11.5-11.5'></path>`,
    items: [
      'Poda, Desbroce y Diseño de Áreas Verdes.',
      'Mantenimiento de Césped, Arbustos y Flores.',
      'Herramientas de Última Generación.',
      'Técnicas Ecológicas con Resultados Vibrantes.',
    ],
  },
]
---

<section id='servicios'>
  <Container>
    <div
      class='reveal flex flex-col gap-10 lg:flex-row lg:items-start lg:gap-16'
    >
      <div class='flex shrink-0 flex-col gap-5 lg:w-[400px]'>
        <Eyebrow text='Servicios' />
        <h2 class='text-4xl leading-none text-ink-bright sm:text-5xl xl:text-[54px]'>
          Nuestros Servicios
        </h2>
      </div>

      <div class='flex flex-col gap-6 pt-1 lg:gap-[26px]'>
        <p class='text-lg leading-relaxed text-ink-muted sm:text-xl xl:text-[21px]'>
          Destacados por la <span class='text-primary-400'>calidad</span> excepcional
          y <span class='text-primary-400'>atención</span> meticulosa a los detalles.
        </p>
        <p class='text-lg leading-relaxed text-ink-muted sm:text-xl xl:text-[21px]'>
          Equipo de <span class='text-secondary-300'>profesionales</span> altamente
          capacitados con productos y equipos de <span class='text-secondary-300'
            >última generación</span
          >.
        </p>
        <p class='text-lg leading-relaxed text-ink-muted sm:text-xl xl:text-[21px]'>
          Nos <span class='text-primary-400'>adaptamos</span> a sus necesidades,
          ofreciendo una experiencia de limpieza y cuidado del jardín <span
            class='text-secondary-300'>inigualable</span
          >.
        </p>
      </div>
    </div>

    <div class='mt-14 grid gap-5 sm:mt-16 lg:mt-24 lg:grid-cols-2'>
      {
        services.map((service, index) => (
          <article
            class='reveal flex flex-col gap-6 rounded-card border border-line bg-surface p-7 transition-colors duration-150 hover:border-line-strong sm:p-9 lg:gap-[26px]'
            style={`--reveal-delay: ${index * 70}ms`}
          >
            <span
              class={
                service.tone === 'warm'
                  ? 'flex size-13 items-center justify-center rounded-tile bg-surface-warm text-secondary-300'
                  : 'flex size-13 items-center justify-center rounded-tile bg-surface-raised text-primary-400'
              }
            >
              <svg
                class='size-6.5'
                xmlns='http://www.w3.org/2000/svg'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='1.7'
                stroke-linecap='round'
                stroke-linejoin='round'
                aria-hidden='true'
                set:html={service.icon}
              />
            </span>

            <h3 class='text-2xl text-ink-bright sm:text-3xl'>{service.title}</h3>

            <ul class='flex flex-col gap-3.5'>
              {service.items.map((item, itemIndex) => {
                const isClosing = itemIndex === service.items.length - 1
                const dash =
                  isClosing || service.tone === 'warm'
                    ? 'text-secondary-300'
                    : 'text-primary-400'

                return (
                  <li
                    class={
                      isClosing
                        ? 'flex gap-3 text-base leading-relaxed font-bold text-ink-soft sm:text-[17px]'
                        : 'flex gap-3 text-base leading-relaxed text-ink-dim sm:text-[17px]'
                    }
                  >
                    <span class={dash} aria-hidden='true'>
                      —
                    </span>
                    {item}
                  </li>
                )
              })}
            </ul>
          </article>
        ))
      }
    </div>
  </Container>
</section>
