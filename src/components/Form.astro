---
import Container from './Container.astro'
import Eyebrow from './Eyebrow.astro'

const fieldClass =
  'w-full rounded-field border border-line bg-surface-sunken px-4 py-4 text-base text-ink transition duration-150 outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-400 sm:text-[17px]'
const labelClass =
  'text-xs font-bold tracking-[0.08em] text-ink-dim uppercase sm:text-sm'
---

<section id='formulario'>
  <Container>
    <div
      class='reveal flex flex-col gap-10 rounded-card border border-line bg-surface p-6 sm:p-10 lg:flex-row lg:gap-16 lg:p-15'
    >
      <div class='flex shrink-0 flex-col gap-6 lg:w-[380px]'>
        <Eyebrow text='Contacto' />
        <h2 class='text-4xl leading-none text-ink-bright sm:text-5xl xl:text-[54px]'>
          Contáctanos
        </h2>
        <p class='text-base leading-relaxed text-ink-dim sm:text-lg'>
          Cuéntanos qué necesitas y te respondemos con una propuesta a la medida
          de tu espacio.
        </p>

        <div aria-hidden='true' class='rhythm-rule h-3 opacity-70'></div>

        <a
          href='https://wa.me/593983514771'
          target='_blank'
          rel='noopener'
          class='flex items-center gap-3 text-base font-bold text-whatsapp transition duration-150 hover:opacity-80 sm:text-[17px]'
        >
          <svg
            class='size-5.5 shrink-0'
            xmlns='http://www.w3.org/2000/svg'
            viewBox='0 0 24 24'
            fill='currentColor'
            aria-hidden='true'
          >
            <path
              fill-rule='evenodd'
              d='M12 4a8 8 0 0 0-6.895 12.06l.569.718-.697 2.359 2.32-.648.379.243A8 8 0 1 0 12 4ZM2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10a9.96 9.96 0 0 1-5.016-1.347l-4.948 1.382 1.426-4.829-.006-.007-.033-.055A9.958 9.958 0 0 1 2 12Z'
              clip-rule='evenodd'></path>
            <path
              d='M16.735 13.492c-.038-.018-1.497-.736-1.756-.83a1.008 1.008 0 0 0-.34-.075c-.196 0-.362.098-.49.291-.146.217-.587.732-.723.886-.018.02-.042.045-.057.045-.013 0-.239-.093-.307-.123-1.564-.68-2.751-2.313-2.914-2.589-.023-.04-.024-.057-.024-.057.005-.021.058-.074.085-.101.08-.079.166-.182.249-.283l.117-.14c.121-.14.175-.25.237-.375l.033-.066a.68.68 0 0 0-.02-.64c-.034-.069-.65-1.555-.715-1.711-.158-.377-.366-.552-.655-.552-.027 0 0 0-.112.005-.137.005-.883.104-1.213.311-.35.22-.94.924-.94 2.16 0 1.112.705 2.162 1.008 2.561l.041.06c1.161 1.695 2.608 2.951 4.074 3.537 1.412.564 2.081.63 2.461.63.16 0 .288-.013.4-.024l.072-.007c.488-.043 1.56-.599 1.804-1.276.192-.534.243-1.117.115-1.329-.088-.144-.239-.216-.43-.308Z'
            ></path>
          </svg>
          +593 98 351 4771
        </a>
      </div>

      <form
        class='flex grow flex-col gap-5 sm:gap-[22px]'
        action='https://formspree.io/f/xjvnzkvn'
        method='POST'
      >
        <div class='grid gap-5 sm:grid-cols-2 sm:gap-[22px]'>
          <div class='flex flex-col gap-2.5'>
            <label for='name' class={labelClass}>Nombre</label>
            <input
              type='text'
              id='name'
              name='Nombre'
              class={fieldClass}
              placeholder='Andrea'
              autocomplete='name'
              required
            />
          </div>

          <div class='flex flex-col gap-2.5'>
            <label for='phone' class={labelClass}>Celular</label>
            <input
              type='tel'
              inputmode='tel'
              id='phone'
              name='Celular'
              class={fieldClass}
              placeholder='0912345678'
              autocomplete='tel'
              required
            />
          </div>
        </div>

        <div class='flex flex-col gap-2.5'>
          <label for='email' class={labelClass}>
            Correo <span class='font-normal tracking-normal text-ink-faint normal-case'
              >(Opcional)</span
            >
          </label>
          <input
            type='email'
            id='email'
            name='Correo'
            class={fieldClass}
            placeholder='correo@mail.com'
            autocomplete='email'
          />
        </div>

        <div class='flex flex-col gap-2.5'>
          <label for='comment' class={labelClass}>¡Déjanos un comentario!</label>
          <textarea
            id='comment'
            name='Comentario'
            rows='4'
            class={`${fieldClass} resize-none`}
            placeholder='Me gustaría contratar...'
            required></textarea>
        </div>

        <button
          type='submit'
          class='flex cursor-pointer items-center justify-center gap-2.5 self-stretch rounded-full bg-primary-400 px-9 py-4 text-base font-bold text-on-accent transition duration-150 hover:bg-primary-300 active:scale-95 sm:text-[17px]'
        >
          Enviar solicitud
          <svg
            class='size-[17px] shrink-0'
            xmlns='http://www.w3.org/2000/svg'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2.4'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'
          >
            <path d='M5 12h14'></path>
            <path d='m12 5 7 7-7 7'></path>
          </svg>
        </button>
      </form>
    </div>
  </Container>
</section>
